
const canvas = document.getElementById("gameCanvas");
const ctx = canvas.getContext("2d");

const W = canvas.width;
const H = canvas.height;

const scoreText = document.getElementById("score");
const livesText = document.getElementById("lives");

const startScreen = document.getElementById("startScreen");
const gameOverScreen = document.getElementById("gameOver");

let running = false;
let score = 0;
let lives = 3;
let frame = 0;
let oceanOffset = 0;

const keys = {};

const player = {
    x: 150,
    y: 190,
    width: 115,
    height: 48,
    speed: 4,
    cooldown: 0,
    bombCooldown: 0,
    angle: 0
};

let bullets = [];
let bombs = [];
let enemies = [];
let explosions = [];
let particles = [];

// CONTROL DEL JUGADOR

function resetGame() {
    score = 0;
    lives = 3;
    frame = 0;

    player.x = 150;
    player.y = 190;
    player.cooldown = 0;
    player.bombCooldown = 0;

    bullets = [];
    bombs = [];
    enemies = [];
    explosions = [];
    particles = [];

    updateHUD();
}

function updateHUD() {
    scoreText.textContent = score;
    livesText.textContent = lives;
}

// FONDO: CIELO Y OCÉANO

function drawBackground() {
    const sky = ctx.createLinearGradient(0, 0, 0, 340);

    sky.addColorStop(0, "#07182e");
    sky.addColorStop(0.65, "#14517a");
    sky.addColorStop(1, "#64a9c5");

    ctx.fillStyle = sky;
    ctx.fillRect(0, 0, W, H);

    // Sol luminoso

    const glow = ctx.createRadialGradient(
        720, 110, 5,
        720, 110, 150
    );

    glow.addColorStop(0, "rgba(160,225,255,0.5)");
    glow.addColorStop(1, "rgba(160,225,255,0)");

    ctx.fillStyle = glow;
    ctx.fillRect(560, 0, 320, 280);

    // Horizonte

    ctx.fillStyle = "#174b68";
    ctx.fillRect(0, 320, W, 220);

    // Agua

    const water = ctx.createLinearGradient(0, 325, 0, H);

    water.addColorStop(0, "#126b91");
    water.addColorStop(0.45, "#064568");
    water.addColorStop(1, "#031b36");

    ctx.fillStyle = water;
    ctx.fillRect(0, 325, W, 215);

    // Olas animadas

    oceanOffset += 1.2;

    for (let i = 0; i < 16; i++) {
        let x = (i * 100 - oceanOffset) % (W + 100);

        ctx.beginPath();
        ctx.moveTo(x, 345 + i % 3 * 12);

        ctx.quadraticCurveTo(
            x + 35,
            335 + i % 3 * 12,
            x + 75,
            345 + i % 3 * 12
        );

        ctx.strokeStyle = "rgba(100,220,255,0.22)";
        ctx.lineWidth = 2;
        ctx.stroke();
    }
}

// AVIÓN PROTAGONISTA

function drawPlayer() {
    ctx.save();

    ctx.translate(
        player.x + player.width / 2,
        player.y + player.height / 2
    );

    ctx.rotate(player.angle);

    // Sombra

    ctx.fillStyle = "rgba(0,0,0,0.25)";
    ctx.beginPath();
    ctx.ellipse(0, 23, 52, 9, 0, 0, Math.PI * 2);
    ctx.fill();

    // Motor y fuego

    ctx.fillStyle = "#f29b43";
    ctx.beginPath();
    ctx.moveTo(-51, -7);
    ctx.lineTo(-79 - Math.random() * 8, 0);
    ctx.lineTo(-51, 7);
    ctx.fill();

    ctx.fillStyle = "#d6f6ff";
    ctx.beginPath();
    ctx.moveTo(-50, -3);
    ctx.lineTo(-66, 0);
    ctx.lineTo(-50, 3);
    ctx.fill();

    // Alas inferiores

    const metal = ctx.createLinearGradient(0, -25, 0, 30);

    metal.addColorStop(0, "#f1f5f8");
    metal.addColorStop(0.45, "#738b9e");
    metal.addColorStop(1, "#263e52");

    ctx.fillStyle = metal;

    ctx.beginPath();
    ctx.moveTo(-18, -7);
    ctx.lineTo(5, -25);
    ctx.lineTo(45, -20);
    ctx.lineTo(20, -4);
    ctx.closePath();
    ctx.fill();

    ctx.beginPath();
    ctx.moveTo(-18, 7);
    ctx.lineTo(5, 25);
    ctx.lineTo(45, 20);
    ctx.lineTo(20, 4);
    ctx.closePath();
    ctx.fill();

    // Fuselaje

    const body = ctx.createLinearGradient(0, -12, 0, 12);

    body.addColorStop(0, "#f6fbff");
    body.addColorStop(0.35, "#aebfcd");
    body.addColorStop(0.7, "#526c80");
    body.addColorStop(1, "#263c50");

    ctx.fillStyle = body;

    ctx.beginPath();
    ctx.moveTo(-57, 0);
    ctx.lineTo(-35, -8);
    ctx.lineTo(35, -9);
    ctx.lineTo(59, -2);
    ctx.lineTo(67, 0);
    ctx.lineTo(59, 3);
    ctx.lineTo(35, 9);
    ctx.lineTo(-35, 8);
    ctx.closePath();
    ctx.fill();

    // Cabina

    const glass = ctx.createLinearGradient(0, -12, 0, 0);

    glass.addColorStop(0, "#a9f1ff");
    glass.addColorStop(1, "#1373a4");

    ctx.fillStyle = glass;

    ctx.beginPath();
    ctx.moveTo(7, -8);
    ctx.lineTo(24, -16);
    ctx.lineTo(39, -8);
    ctx.lineTo(27, -3);
    ctx.closePath();
    ctx.fill();

    // Aleta trasera

    ctx.fillStyle = "#829bad";
    ctx.beginPath();
    ctx.moveTo(-43, -6);
    ctx.lineTo(-54, -20);
    ctx.lineTo(-28, -9);
    ctx.closePath();
    ctx.fill();

    // Líneas metálicas

    ctx.strokeStyle = "#e2f6ff";
    ctx.lineWidth = 1;

    ctx.beginPath();
    ctx.moveTo(-28, -3);
    ctx.lineTo(45, -3);
    ctx.stroke();

    ctx.restore();
}

// BARCOS ENEMIGOS

function drawShip(ship) {
    ctx.save();
    ctx.translate(ship.x, ship.y);

    const metal = ctx.createLinearGradient(0, -25, 0, 25);

    metal.addColorStop(0, "#b9cbd5");
    metal.addColorStop(0.5, "#526b7c");
    metal.addColorStop(1, "#263c50");

    // Casco

    ctx.fillStyle = metal;

    ctx.beginPath();
    ctx.moveTo(-65, -3);
    ctx.lineTo(58, -3);
    ctx.lineTo(72, 9);
    ctx.lineTo(48, 22);
    ctx.lineTo(-48, 22);
    ctx.lineTo(-70, 8);
    ctx.closePath();
    ctx.fill();

    // Cubierta

    ctx.fillStyle = "#8299a8";
    ctx.fillRect(-37, -15, 75, 13);

    // Torre central

    ctx.fillStyle = "#aebdc6";
    ctx.fillRect(-14, -29, 30, 15);

    // Antena

    ctx.strokeStyle = "#d5e6ed";
    ctx.lineWidth = 2;
    ctx.beginPath();
    ctx.moveTo(0, -29);
    ctx.lineTo(0, -44);
    ctx.stroke();

    // Cañón estilizado

    ctx.fillStyle = "#263d50";
    ctx.fillRect(17, -24, 24, 5);

    // Ventanas

    ctx.fillStyle = "#64d8f5";

    for (let i = 0; i < 4; i++) {
        ctx.fillRect(-29 + i * 15, -11, 8, 5);
    }

    ctx.restore();
}

// AVIONES ENEMIGOS

function drawEnemy(enemy) {
    ctx.save();
    ctx.translate(enemy.x, enemy.y);

    ctx.scale(-1, 1);

    const metal = ctx.createLinearGradient(0, -20, 0, 20);

    metal.addColorStop(0, "#ffbd81");
    metal.addColorStop(0.5, "#8d6371");
    metal.addColorStop(1, "#39485b");

    ctx.fillStyle = metal;

    ctx.beginPath();
    ctx.moveTo(-38, 0);
    ctx.lineTo(-20, -7);
    ctx.lineTo(25, -7);
    ctx.lineTo(44, 0);
    ctx.lineTo(25, 7);
    ctx.lineTo(-20, 7);
    ctx.closePath();
    ctx.fill();

    ctx.beginPath();
    ctx.moveTo(-5, -5);
    ctx.lineTo(12, -21);
    ctx.lineTo(33, -15);
    ctx.lineTo(15, -3);
    ctx.closePath();
    ctx.fill();

    ctx.fillStyle = "#b5efff";
    ctx.beginPath();
    ctx.moveTo(10, -7);
    ctx.lineTo(25, -13);
    ctx.lineTo(33, -7);
    ctx.closePath();
    ctx.fill();

    ctx.restore();
}

// DISPAROS DEL JUGADOR

function shoot() {
    if (player.cooldown > 0) return;

    bullets.push({
        x: player.x + 65,
        y: player.y + 20,
        speed: 9
    });

    player.cooldown = 13;
}

// LANZAMIENTO DE BOMBAS

function dropBomb() {
    if (player.bombCooldown > 0) return;

    bombs.push({
        x: player.x + 35,
        y: player.y + 35,
        vy: 2
    });

    player.bombCooldown = 55;
}

// GENERACIÓN DE ENEMIGOS

function spawnEnemies() {
    if (frame % 180 === 0) {
        enemies.push({
            type: "ship",
            x: W + 100,
            y: 410 + Math.random() * 65,
            hp: 3,
            speed: 1.5
        });
    }

    if (frame % 115 === 0) {
        enemies.push({
            type: "plane",
            x: W + 50,
            y: 70 + Math.random() * 220,
            hp: 1,
            speed: 2.4,
            phase: Math.random() * 6
        });
    }
}

// EXPLOSIONES

function createExplosion(x, y) {
    explosions.push({
        x,
        y,
        radius: 5,
        alpha: 1
    });

    for (let i = 0; i < 12; i++) {
        particles.push({
            x,
            y,
            vx: (Math.random() - 0.5) * 6,
            vy: (Math.random() - 0.5) * 6,
            life: 30
        });
    }
}

function drawEffects() {
    explosions.forEach(e => {
        ctx.beginPath();
        ctx.arc(e.x, e.y, e.radius, 0, Math.PI * 2);
        ctx.fillStyle = `rgba(255,150,45,${e.alpha})`;
        ctx.fill();
    });

    particles.forEach(p => {
        ctx.fillStyle = `rgba(255,200,120,${p.life / 30})`;
        ctx.fillRect(p.x, p.y, 4, 4);
    });
}

// ACTUALIZACIÓN DE LOS ELEMENTOS

function update() {
    frame++;

    // Movimiento del avión

    if (keys.up) player.y -= player.speed;
    if (keys.down) player.y += player.speed;
    if (keys.left) player.x -= player.speed;
    if (keys.right) player.x += player.speed;

    player.x = Math.max(20, Math.min(W - 120, player.x));
    player.y = Math.max(20, Math.min(340, player.y));

    // Inclinación visual

    player.angle = keys.up ? -0.12 : keys.down ? 0.12 : 0;

    if (keys.shoot) shoot();
    if (keys.bomb) dropBomb();

    if (player.cooldown > 0) player.cooldown--;
    if (player.bombCooldown > 0) player.bombCooldown--;

    // Movimiento de disparos

    bullets.forEach(b => b.x += b.speed);
    bullets = bullets.filter(b => b.x < W + 20);

    // Bombas

    bombs.forEach(b => {
        b.x += 1;
        b.y += b.vy;
        b.vy += 0.12;
    });

    bombs = bombs.filter(b => b.y < H + 30);

    // Enemigos

    spawnEnemies();

    enemies.forEach(e => {
        e.x -= e.speed;

        if (e.type === "plane") {
            e.y += Math.sin(frame * 0.045 + e.phase) * 1.5;
        }
    });

    // Colisiones de disparos

    bullets.forEach(b => {
        enemies.forEach(e => {
            if (
                !e.dead &&
                Math.abs(b.x - e.x) < 55 &&
                Math.abs(b.y - e.y) < 35
            ) {
                e.hp--;
                b.x = W + 100;

                if (e.hp <= 0) {
                    e.dead = true;
                    score += e.type === "ship" ? 100 : 50;
                    createExplosion(e.x, e.y);
                    updateHUD();
                }
            }
        });
    });

    // Colisiones de bombas

    bombs.forEach(b => {
        enemies.forEach(e => {
            if (
                !e.dead &&
                Math.abs(b.x - e.x) < 65 &&
                Math.abs(b.y - e.y) < 40
            ) {
                e.dead = true;
                b.y = H + 100;
                score += 100;
                createExplosion(e.x, e.y);
                updateHUD();
            }
        });
    });

    // Enemigos que salen de pantalla

    enemies = enemies.filter(e => e.x > -100 && !e.dead);

    // Contacto entre avión y enemigo

    enemies.forEach(e => {
        if (
            Math.abs(player.x + 55 - e.x) < 45 &&
            Math.abs(player.y + 24 - e.y) < 35
        ) {
            e.dead = true;
            createExplosion(e.x, e.y);
            lives--;
            updateHUD();

            if (lives <= 0) endGame();
        }
    });

    enemies = enemies.filter(e => !e.dead);

    // Animación de explosiones

    explosions.forEach(e => {
        e.radius += 2;
        e.alpha -= 0.035;
    });

    explosions = explosions.filter(e => e.alpha > 0);

    particles.forEach(p => {
        p.x += p.vx;
        p.y += p.vy;
        p.life--;
    });

    particles = particles.filter(p => p.life > 0);
}

// DIBUJO DE DISPAROS Y BOMBAS

function drawProjectiles() {
    bullets.forEach(b => {
        ctx.fillStyle = "#8af3ff";
        ctx.shadowColor = "#00d9ff";
        ctx.shadowBlur = 12;

        ctx.fillRect(b.x, b.y, 17, 4);

        ctx.shadowBlur = 0;
    });

    bombs.forEach(b => {
        ctx.fillStyle = "#26394d";
        ctx.beginPath();
        ctx.ellipse(b.x, b.y, 6, 12, 0, 0, Math.PI * 2);
        ctx.fill();

        ctx.fillStyle = "#d5e2e9";
        ctx.fillRect(b.x - 2, b.y - 10, 4, 4);
    });
}

// DIBUJO GENERAL

function draw() {
    drawBackground();

    enemies.forEach(e => {
        if (e.type === "ship") {
            drawShip(e);
        } else {
            drawEnemy(e);
        }
    });

    drawProjectiles();
    drawPlayer();
    drawEffects();
}

// BUCLE DEL VIDEOJUEGO

function gameLoop() {
    if (!running) return;

    update();
    draw();

    requestAnimationFrame(gameLoop);
}

// FINALIZAR PARTIDA

function endGame() {
    running = false;

    document.getElementById("finalScore").textContent = score;
    gameOverScreen.classList.remove("hidden");
}

// INICIAR Y REINICIAR

function startGame() {
    resetGame();

    startScreen.classList.add("hidden");
    gameOverScreen.classList.add("hidden");

    running = true;
    gameLoop();
}

document.getElementById("startBtn").addEventListener("click", startGame);
document.getElementById("restartBtn").addEventListener("click", startGame);

// CONTROLES DE TECLADO

const keyMap = {
    ArrowUp: "up",
    ArrowDown: "down",
    ArrowLeft: "left",
    ArrowRight: "right",
    w: "up",
    s: "down",
    a: "left",
    d: "right",
    " ": "shoot",
    x: "bomb"
};

window.addEventListener("keydown", e => {
    const key = keyMap[e.key];

    if (key) {
        e.preventDefault();
        keys[key] = true;
    }
});

window.addEventListener("keyup", e => {
    const key = keyMap[e.key];

    if (key) keys[key] = false;
});

// CONTROLES TÁCTILES

document.querySelectorAll("[data-key]").forEach(button => {
    const key = button.dataset.key;

    button.addEventListener("pointerdown", e => {
        e.preventDefault();
        keys[key] = true;
        button.setPointerCapture(e.pointerId);
    });

    const release = () => {
        keys[key] = false;
    };

    button.addEventListener("pointerup", release);
    button.addEventListener("pointercancel", release);
    button.addEventListener("lostpointercapture", release);
});

// PANTALLA INICIAL

drawBackground();
drawPlayer();
